---
import { translations, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  t: (typeof translations)[Lang];
}

const { lang, t } = Astro.props;
const home = lang === 'de' ? '/' : '/en/';
const target = `${home}#top`;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <a class="footer-line" href={target}>
      {t.footerLine}
    </a>
    <a class="footer-egg" href={target} aria-hidden="true" tabindex="-1">
      {t.footerEgg}
    </a>
  </div>
</footer>
