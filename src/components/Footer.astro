---
export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const home = lang === 'de' ? '/de/' : '/';
const target = `${home}#top`;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <a class="footer-line" href={target}>© 2026 · handmade w/ html & vibes</a>
    <a class="footer-egg" href={target} aria-hidden="true" tabindex="-1">:3</a>
  </div>
</footer>
