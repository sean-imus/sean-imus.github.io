---
export interface Props {
  lang: string;
  t: {
    footerLine: string;
    footerEgg: string;
  };
}

const { lang, t } = Astro.props;
const home = lang === 'de' ? '/' : '/en/';
const target = `${home}#top`;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <a class="footer-line" href={target}>{t.footerLine}</a>
    <a class="footer-egg" href={target} aria-hidden="true" tabindex="-1">{t.footerEgg}</a>
  </div>
</footer>
